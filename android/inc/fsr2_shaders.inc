"#include \"ffx_fsr2_common.h\"\n"
"\n"
"#if defined(FSR2_BIND_CB_SPD)\n"
"	layout (set = 1, binding = FSR2_BIND_CB_SPD, std140) uniform cbSPD_t\n"
"	{\n"
"		uint mips;\n"
"		uint numWorkGroups;\n"
"		uvec2 workGroupOffset;\n"
"		uvec2 renderSize;\n"
"	} cbSPD;\n"
"\n"
"	uint MipCount()\n"
"	{\n"
"		return cbSPD.mips;\n"
"	}\n"
"\n"
"	uint NumWorkGroups()\n"
"	{\n"
"		return cbSPD.numWorkGroups;\n"
"	}\n"
"\n"
"	uvec2 WorkGroupOffset()\n"
"	{\n"
"		return cbSPD.workGroupOffset;\n"
"	}\n"
