"FFX_STATIC FfxFloat32 ffxMin(FfxFloat32 x, FfxFloat32 y)\n"
"{\n"
"    return x < y ? x : y;\n"
"}\n"
"\n"
"FFX_STATIC FfxUInt32 ffxMin(FfxUInt32 x, FfxUInt32 y)\n"
