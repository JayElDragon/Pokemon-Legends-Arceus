"}\n"
"\n"
"/// Clamp a value to a [0..1] range.\n"
"///\n"
"/// @param [in] x               The value to clamp to [0..1] range.\n"
"///\n"
"/// @returns\n"
"/// The clamped version of <c><i>x</i></c>.\n"
"///\n"
"/// @ingroup CPU\n"
"FFX_STATIC FfxFloat32 ffxSaturate(FfxFloat32 a)\n"
"{\n"
"    return ffxMin(1.0f, ffxMax(0.0f, a));\n"
"}\n"
